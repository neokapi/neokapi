    {
      "id": "emails-nb:1368cf8502",
      "hintSrcLang": "en",
      "variants": {
        "en": [
          {
            "text": "Someone — hopefully you — asked to change a Bowrain account's email to "
          },
          {
            "pcOpen": {
              "id": "0",
              "type": "jsx:element",
              "subType": "strong",
              "data": "{=m0}",
              "equiv": "=m0"
            }
          },
          {
            "ph": {
              "id": "2",
              "type": "jsx:var",
              "data": "{newEmail}",
              "equiv": "newEmail"
            }
          },
          {
            "pcClose": {
              "id": "0",
              "type": "jsx:element",
              "subType": "strong",
              "data": "{/=m0}",
              "equiv": "=m0"
            }
          },
          {
            "text": ". Click the button below to confirm and finish the switch."
          }
        ],
        "nb": [
          {
            "text": "Noen — forhåpentligvis du — har bedt om å endre e-postadressen til en Bowrain-konto til "
          },
          {
            "pcOpen": {
              "id": "0",
              "type": "jsx:element",
              "subType": "strong",
              "data": "{=m0}",
              "equiv": "=m0"
            }
          },
          {
            "ph": {
              "id": "2",
              "type": "jsx:var",
              "data": "{newEmail}",
              "equiv": "newEmail"
            }
          },
          {
            "pcClose": {
              "id": "0",
              "type": "jsx:element",
              "subType": "strong",
              "data": "{/=m0}",
              "equiv": "=m0"
            }
          },
          {
            "text": ". Klikk på knappen nedenfor for å bekrefte og fullføre byttet."
          }
        ]
      },
      "created": "2026-07-17T00:00:00Z",
      "updated": "2026-07-17T00:00:00Z"
    },
