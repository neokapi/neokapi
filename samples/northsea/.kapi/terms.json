  "schemaVersion": "1.0",
  "kind": "kapi-terms",
  "concepts": [
    {
      "id": "term:en-GB:alert",
      "domain": "operations",
      "definition": "A statement that one scheduled movement, at one berth, in one window, has stopped being safe. Not a general weather warning.",
      "source": "terminology",
      "terms": [
        {
          "text": "alert",
          "locale": "en-GB",
          "status": "preferred"
        },
        {
          "text": "warning",
          "locale": "en-GB",
          "status": "deprecated",
          "note": "use: alert"
        }
      ],
      "created_at": "2026-01-20T09:00:00Z",
      "updated_at": "2026-01-20T09:00:00Z"
    },
    {
      "id": "term:en-GB:berth",
      "domain": "operations",
      "definition": "The place a vessel occupies alongside. Renamed from \"mooring\" on 2026-01-20; the API field mooring_id keeps the retired spelling because it is part of the published contract.",
      "source": "terminology",
      "terms": [
        {
          "text": "berth",
          "locale": "en-GB",
          "status": "preferred"
        },
        {
          "text": "mooring",
          "locale": "en-GB",
          "status": "deprecated",
          "note": "use: berth"
        }
      ],
      "created_at": "2026-01-20T09:00:00Z",
      "updated_at": "2026-01-20T09:00:00Z"
    },
    {
      "id": "term:en-GB:compass",
      "domain": "product",
      "definition": "The Northsea fleet and berth-plan product. A product name, never translated and never lowercased.",
      "source": "terminology",
      "terms": [
        {
          "text": "Compass",
          "locale": "en-GB",
          "status": "preferred"
        }
      ],
      "created_at": "2025-09-16T09:00:00Z",
      "updated_at": "2025-09-16T09:00:00Z"
    },
    {
      "id": "term:en-GB:mooring-id",
      "domain": "api",
      "definition": "The API field that identifies a berth. Named before the vocabulary was settled and kept as it is: the field is part of the published contract, so the rename stops at the wire.",
      "source": "terminology",
      "terms": [
        {
          "text": "mooring_id",
          "locale": "en-GB",
          "status": "admitted",
          "note": "API field name — correct in the API reference, wrong in prose"
        }
      ],
      "created_at": "2026-01-20T09:00:00Z",
      "updated_at": "2026-01-20T09:00:00Z"
    },
    {
      "id": "term:en-GB:tidectl",
      "domain": "product",
      "definition": "The Northsea command line. One word, always lowercase, never translated.",
      "source": "terminology",
      "terms": [
        {
          "text": "tidectl",
          "locale": "en-GB",
          "status": "preferred"
        }
      ],
      "created_at": "2025-09-16T09:00:00Z",
      "updated_at": "2025-09-16T09:00:00Z"
    },
    {
      "id": "term:en-GB:tidewatch",
      "domain": "product",
      "definition": "The Northsea forecasting and alerting product. A coined name, never translated.",
      "source": "terminology",
      "terms": [
        {
          "text": "Tidewatch",
          "locale": "en-GB",
          "status": "preferred"
        }
      ],
      "created_at": "2025-09-16T09:00:00Z",
      "updated_at": "2025-09-16T09:00:00Z"
    },
    {
      "id": "term:en-GB:vessel",
      "domain": "operations",
      "definition": "Anything on the arrivals plan that floats and moves under its own power or under tow. The arrivals model calls everything a vessel.",
      "source": "terminology",
      "terms": [
        {
          "text": "ship",
          "locale": "en-GB",
          "status": "deprecated",
          "note": "use: vessel"
        },
        {
          "text": "vessel",
          "locale": "en-GB",
          "status": "preferred"
        }
      ],
      "created_at": "2025-09-16T09:00:00Z",
      "updated_at": "2025-09-16T09:00:00Z"
    }
