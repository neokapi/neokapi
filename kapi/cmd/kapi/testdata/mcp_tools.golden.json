[
  {
    "name": "apply_edits",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "changeset": {
          "description": "the typed change-set entries to apply",
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_hash": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "list": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "op": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              },
              "replaces": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "source_locale": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "target_locale": {
                "type": "string"
              },
              "term": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "value": {
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "changeset"
      ],
      "type": "object"
    }
  },
  {
    "name": "approve_unit",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Target file path, as listed by review_queue",
          "type": "string"
        },
        "key": {
          "description": "Unit key, as listed by review_queue",
          "type": "string"
        },
        "locale": {
          "description": "Target locale, as listed by review_queue",
          "type": "string"
        },
        "note": {
          "description": "Reviewer note (the reason, for reject_unit)",
          "type": "string"
        },
        "project": {
          "description": "Path to the .kapi project file (default: the ambient project)",
          "type": "string"
        }
      },
      "required": [
        "locale",
        "file",
        "key"
      ],
      "type": "object"
    }
  },
  {
    "name": "check_file",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "dnt": {
          "description": "do-not-translate terms that must survive verbatim into the target",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "file": {
          "description": "path to the file whose content should be checked",
          "type": "string"
        },
        "forbid": {
          "description": "regex that must NOT appear in the content",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "max_chars": {
          "description": "flag content longer than this many characters (0 = off)",
          "type": "integer"
        },
        "max_words": {
          "description": "flag content with more than this many words (0 = off)",
          "type": "integer"
        },
        "profile_file": {
          "description": "path to a voice profile YAML",
          "type": "string"
        },
        "profile_pack": {
          "description": "built-in profile pack to check vocabulary against",
          "type": "string"
        },
        "require": {
          "description": "regex that MUST appear in the content",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "target": {
          "description": "translated target file to check against the source (enables the bilingual source-against-target checks)",
          "type": "string"
        },
        "target_lang": {
          "description": "locale of the target file (e.g. de)",
          "type": "string"
        },
        "validate": {
          "description": "reader structure/encoding validation: off|report|strict (report folds structure.*/encoding.* findings into the report; strict also fails on a Major+ structure/encoding problem). Default off.",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "type": "object"
    }
  },
  {
    "name": "check_text",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "forbid": {
          "description": "regex that must NOT appear in the content",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "max_chars": {
          "description": "flag content longer than this many characters (0 = off)",
          "type": "integer"
        },
        "max_words": {
          "description": "flag content with more than this many words (0 = off)",
          "type": "integer"
        },
        "profile_file": {
          "description": "path to a voice profile YAML",
          "type": "string"
        },
        "profile_pack": {
          "description": "built-in profile pack to check vocabulary against (e.g. marketing-blog)",
          "type": "string"
        },
        "require": {
          "description": "regex that MUST appear in the content",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "text": {
          "description": "the text to verify",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  {
    "name": "context_search",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "max results per group (default 10)",
          "type": "integer"
        },
        "locale": {
          "description": "narrow results to one language (e.g. en, fr)",
          "type": "string"
        },
        "memory": {
          "description": "path to a standalone content memory (default: the project's own store)",
          "type": "string"
        },
        "query": {
          "description": "the word or phrase to ask about",
          "type": "string"
        },
        "terms": {
          "description": "path to a standalone terms store (default: the project's own store)",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  },
  {
    "name": "detect_format",
