  {
    "name": "translate",
    "input_schema": {
      "$id": "translate",
      "description": "Translate content with an LLM or machine-translation provider (select an engine, then a provider)",
      "properties": {
        "apiKey": {
          "description": "API key for the AI provider",
          "title": "API Key",
          "type": "string"
        },
        "batchConcurrency": {
          "default": 1,
          "description": "Number of concurrent batch calls (0 or 1 = sequential)",
          "minimum": 1,
          "title": "Batch Concurrency",
          "type": "integer"
        },
        "batching": {
          "default": "auto",
          "description": "How many blocks share one LLM call",
          "options": [
            {
              "label": "auto",
              "value": "auto"
            },
            {
              "label": "single",
              "value": "single"
            }
          ],
          "title": "Batching",
          "type": "string"
        },
        "context": {
          "default": "key",
          "description": "What the model is told about a block besides the block itself",
          "options": [
            {
              "label": "none",
              "value": "none"
            },
            {
              "label": "key",
              "value": "key"
            },
            {
              "label": "neighbours",
              "value": "neighbours"
            }
          ],
          "title": "Context",
          "type": "string"
        },
        "contextWindow": {
          "default": 2,
          "description": "Blocks either side to send as reference (with context: neighbours)",
          "maximum": 10,
          "minimum": 1,
          "title": "Context Window",
          "type": "integer"
        },
        "engine": {
          "default": "llm",
          "description": "Translation engine: an AI model or a machine-translation provider",
          "options": [
            {
              "label": "AI (LLM)",
              "value": "llm"
            },
            {
              "label": "Machine translation",
              "value": "mt"
            }
          ],
          "title": "Engine",
          "type": "string",
          "ui:enum-descriptions": {
            "llm": "Translate with a large language model.",
            "mt": "Translate with a plugin-provided machine-translation engine."
          },
          "ui:order": 0,
          "ui:widget": "select"
        },
        "instruction": {
          "description": "Extra guidance for the model while translating (e.g. 'informal register; keep product names in English')",
          "title": "Instruction",
          "type": "string",
          "ui:widget": "textarea"
        },
        "model": {
          "description": "AI model name",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "anthropic",
          "description": "AI provider",
          "options": [
            {
              "label": "Anthropic",
              "value": "anthropic"
            },
            {
              "label": "OpenAI",
              "value": "openai"
            },
            {
              "label": "Gemini",
              "value": "gemini"
            },
            {
              "label": "Azure OpenAI",
              "value": "azureopenai"
            },
            {
              "label": "Claude Code",
              "value": "claude-code"
            },
            {
              "label": "Ollama",
              "value": "ollama"
            },
            {
              "label": "Demo (illustrative)",
              "value": "demo"
            }
          ],
          "title": "AI Provider",
          "type": "string",
          "ui:option-sets": [
            {
              "options": [
                {
                  "label": "Anthropic",
                  "value": "anthropic"
                },
                {
                  "label": "OpenAI",
                  "value": "openai"
                },
                {
                  "label": "Gemini",
                  "value": "gemini"
                },
                {
                  "label": "Azure OpenAI",
                  "value": "azureopenai"
                },
                {
                  "label": "Claude Code",
                  "value": "claude-code"
                },
                {
                  "label": "Ollama",
                  "value": "ollama"
                },
                {
                  "label": "Demo (illustrative)",
                  "value": "demo"
                }
              ],
              "when": {
                "eq": "llm",
                "field": "engine"
              }
            },
            {
              "options": [],
              "when": {
                "eq": "mt",
                "field": "engine"
              }
            }
          ],
          "ui:widget": "select"
        },
        "reuse": {
          "default": "prior",
          "description": "Offer a block's previously approved translation to the model as reference",
          "options": [
            {
              "label": "prior",
              "value": "prior"
            },
            {
              "label": "none",
              "value": "none"
            }
          ],
          "title": "Reuse Prior Translation",
          "type": "string"
        },
        "skipMatched": {
          "default": false,
          "description": "Skip blocks that already have a target translation",
          "title": "Skip Matched",
          "type": "boolean"
        },
        "target_lang": {
          "description": "BCP-47 target language (e.g. fr, de). Defaults to the project's target when run inside a project.",
          "type": "string"
        },
        "text": {
          "description": "The content (text) to run the tool over.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Translate",
      "toolMeta": {
        "accepts": [
          "memory"
        ],
        "cardinality": "bilingual",
        "category": "translation",
        "defaultParallelBlocks": 5,
        "description": "Translate content with an LLM or machine-translation provider (select an engine, then a provider)",
        "displayName": "Translate",
        "id": "translate",
        "produces": [
          {
            "side": "target",
            "type": "target"
          }
        ],
        "requires": [
          "target-language",
          "credentials"
        ],
        "sideEffects": [
          "api-call",
          "remote-source-egress"
        ],
        "tags": [
          "translation",
          "l10n"
        ],
        "writesOutput": true
      },
      "type": "object",
      "ui:groups": [
        {
          "fields": [
            "engine",
            "provider",
            "apiKey",
            "model",
            "batching"
          ],
          "id": "provider",
          "label": "Provider"
        },
        {
          "fields": [
            "instruction",
            "reuse",
            "context",
            "contextWindow"
          ],
          "id": "prompt",
          "label": "Prompt"
        }
      ]
    }
  },
  {
    "name": "up",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "description": "how many languages to catch up concurrently per pass (0 = project default, else 4)",
          "type": "integer"
        },
        "local": {
          "description": "in a server-connected project, run the loop on this machine and push the results, instead of running it on the server",
          "type": "boolean"
        },
        "materialize": {
          "description": "after the loop, write the target-language files for every shippable locale (overrides the recipe's materialize policy)",
          "type": "boolean"
        },
        "no_checks": {
          "description": "skip the project's bound checks inside the loop (failing units then count as translated)",
          "type": "boolean"
        },
        "passes": {
          "description": "maximum reconciliation passes (0 = loop until up to date or parked; 1 = single pass)",
          "type": "integer"
        },
        "project": {
          "description": "path to the kapi.yaml recipe (default: discovered upward from the working directory, like git)",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
