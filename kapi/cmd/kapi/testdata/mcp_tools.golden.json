      ],
      "type": "object"
    }
  },
  {
    "name": "extract_content",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "Override format detection",
          "type": "string"
        },
        "path": {
          "description": "File path to extract content from",
          "type": "string"
        },
        "project": {
          "description": "Path to .kapi project file for scoped format detection",
          "type": "string"
        },
        "source_lang": {
          "description": "Source language (default: en)",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "redact",
    "input_schema": {
      "$id": "redact",
      "description": "Replace sensitive spans with protected placeholders before processing",
      "properties": {
        "detectors": {
          "description": "Detection backends to run: rules and/or entities",
          "items": {
            "type": "string"
          },
          "title": "Detectors",
          "type": "array"
        },
        "entityTypes": {
          "description": "Entity categories to redact: person",
          "items": {
            "type": "string"
          },
          "title": "Entity Categories",
          "type": "array"
        },
        "placeholder": {
          "description": "Visible stand-in template; supports {category} and {n}",
          "title": "Placeholder Template",
          "type": "string"
        },
        "rulesPath": {
          "description": "Path to a redaction rules YAML file",
          "title": "Rules File",
          "type": "string"
        },
        "target_lang": {
          "description": "BCP-47 target language (e.g. fr, de). Defaults to the project's target when run inside a project.",
          "type": "string"
        },
        "text": {
          "description": "The content (text) to run the tool over.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Redact",
      "toolMeta": {
        "cardinality": "monolingual",
        "category": "text-processing",
        "consumes": [
          {
            "optional": true,
            "type": "entity"
          }
        ],
        "description": "Replace sensitive spans with protected placeholders before processing",
        "displayName": "Redact",
        "id": "redact",
        "produces": [
          {
            "type": "source"
          },
          {
            "type": "redaction.secret"
          }
        ],
        "recoverable": true,
        "tags": [
          "security",
          "redaction"
        ],
        "writesOutput": true
      },
      "type": "object"
    }
  },
