            }
          ]
        },
        {
          "id": "tu4",
          "translatable": true,
          "runs": [
            {
              "text": "A video appointment is a planned conversation with a Harbor Help adviser. You can use a phone, tablet or computer."
            }
          ]
        },
        {
          "id": "tu5",
          "translatable": true,
          "runs": [
            {
              "text": "What is the same for everyone"
