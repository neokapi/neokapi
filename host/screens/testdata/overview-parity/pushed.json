  "items": [
    {
      "name": "site/locales/en/child.json",
      "format": "json",
      "collection": "child-page",
      "blocks": [
        {
          "id": "tu1",
          "translatable": true,
          "runs": [
            {
              "text": "Children"
            }
          ]
        },
        {
          "id": "tu2",
          "translatable": true,
          "runs": [
            {
              "text": "Harbor Help"
            }
          ]
        },
        {
          "id": "tu3",
          "translatable": true,
          "runs": [
            {
              "text": "Talk to us on a screen"
            }
          ]
        },
        {
          "id": "tu4",
          "translatable": true,
          "runs": [
            {
              "text": "A video appointment is a time when you can talk with a Harbor Help adviser on a screen."
            }
          ]
        },
        {
          "id": "tu5",
          "translatable": true,
          "runs": [
            {
              "text": "What is the same for everyone"
            }
          ]
        },
        {
          "id": "tu6",
          "translatable": true,
          "runs": [
            {
              "text": "A video appointment is not recorded. Harbor Help cannot see inside your device."
            }
          ]
        },
        {
          "id": "tu7",
          "translatable": true,
          "runs": [
            {
              "text": "Keep your information safe"
            }
          ]
        },
        {
          "id": "tu8",
          "translatable": true,
          "runs": [
            {
              "text": "We will not ask for your password or bank details. Ask a trusted adult if you are unsure."
            }
          ]
        },
        {
          "id": "tu9",
          "translatable": true,
          "runs": [
            {
              "text": "Ask a trusted adult to book a video call with you. It is risk-free."
            }
          ]
        },
        {
          "id": "tu10",
          "translatable": true,
          "runs": [
            {
              "text": "A grown-up can call the support line if you need help."
            }
          ]
        }
      ]
    },
    {
      "name": "site/locales/en/adult.json",
      "format": "json",
      "collection": "adult-page",
      "blocks": [
        {
          "id": "tu1",
          "translatable": true,
          "runs": [
            {
              "text": "Adults"
            }
          ]
        },
        {
          "id": "tu2",
          "translatable": true,
          "runs": [
            {
              "text": "Harbor Help"
            }
          ]
        },
        {
          "id": "tu3",
          "translatable": true,
          "runs": [
            {
              "text": "Book a video appointment"
            }
          ]
        },
        {
          "id": "tu4",
          "translatable": true,
          "runs": [
            {
              "text": "A video appointment is a scheduled conversation with a Harbor Help adviser using your phone, tablet or computer."
            }
          ]
        },
        {
          "id": "tu5",
          "translatable": true,
          "runs": [
            {
              "text": "What is the same for everyone"
            }
          ]
        },
        {
          "id": "tu6",
          "translatable": true,
          "runs": [
            {
              "text": "A video appointment is not recorded. Harbor Help cannot access your device or its files."
            }
          ]
        },
        {
          "id": "tu7",
          "translatable": true,
          "runs": [
            {
              "text": "Privacy and security"
            }
          ]
        },
        {
          "id": "tu8",
          "translatable": true,
          "runs": [
            {
              "text": "We will not ask for your password or bank details. Use the support line if you need help before your appointment."
            }
          ]
        },
        {
          "id": "tu9",
          "translatable": true,
          "runs": [
            {
              "text": "Choose an available time and book your video appointment."
            }
          ]
        },
        {
          "id": "tu10",
          "translatable": true,
          "runs": [
            {
              "text": "Call the support line for practical help with booking or joining."
            }
          ]
        }
      ]
    },
    {
