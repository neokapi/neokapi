#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/project/node_modules/.pnpm/oxfmt@0.76.0_vite-plus@1.5.0_@types+node@26.6.6_@vitest+ui@5.1.0_esbuild@0.28.2_jiti@2._c86b7a732efb9f5cfe9641a483b489ce/node_modules/oxfmt/node_modules:/project/node_modules/.pnpm/oxfmt@0.76.0_vite-plus@1.5.0_@types+node@26.6.6_@vitest+ui@5.1.0_esbuild@0.28.2_jiti@2._c86b7a732efb9f5cfe9641a483b489ce/node_modules:/project/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/project/node_modules/.pnpm/oxfmt@0.76.0_vite-plus@1.5.0_@types+node@26.6.6_@vitest+ui@5.1.0_esbuild@0.28.2_jiti@2._c86b7a732efb9f5cfe9641a483b489ce/node_modules/oxfmt/node_modules:/project/node_modules/.pnpm/oxfmt@0.76.0_vite-plus@1.5.0_@types+node@26.6.6_@vitest+ui@5.1.0_esbuild@0.28.2_jiti@2._c86b7a732efb9f5cfe9641a483b489ce/node_modules:/project/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../oxfmt/bin/oxfmt" "$@"
else
  exec node  "$basedir/../oxfmt/bin/oxfmt" "$@"
fi
# cmd-shim-target=/project/node_modules/oxfmt/bin/oxfmt
