{
  "name": "@neokapi/i18n-react",
  "version": "1.2.3",
  "private": false,
  "description": "Zero-config i18n for React. Transforms vanilla JSX at build time using W3C HTML5 translatability rules. Supports build-time inlining (zero runtime) and OTA dynamic loading. Extracts translatable content as Kapi Bundle Format (KBF).",
  "keywords": [
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "nextjs",
    "react",
    "translation",
    "vite",
    "webpack"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neokapi/neokapi.git",
    "directory": "packages/i18n-react"
  },
  "homepage": "https://github.com/neokapi/neokapi/tree/main/packages/i18n-react#readme",
  "bin": {
    "neokapi-i18n": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./vite": {
      "types": "./dist/plugin/vite.d.ts",
      "default": "./dist/plugin/vite.js"
    },
    "./webpack": {
      "types": "./dist/plugin/webpack.d.ts",
      "default": "./dist/plugin/webpack.js"
    },
    "./loader": {
      "types": "./dist/plugin/loader.d.ts",
      "default": "./dist/plugin/loader.js"
    },
    "./rollup": {
      "types": "./dist/plugin/rollup.d.ts",
      "default": "./dist/plugin/rollup.js"
    },
    "./esbuild": {
      "types": "./dist/plugin/esbuild.d.ts",
      "default": "./dist/plugin/esbuild.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/pseudo": {
      "types": "./dist/runtime/pseudo.d.ts",
      "default": "./dist/runtime/pseudo.js"
    },
    "./head": {
      "types": "./dist/head/index.d.ts",
      "default": "./dist/head/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "default": "./dist/review/index.js"
    },
    "./review/hosted": {
      "types": "./dist/review/hosted.d.ts",
      "default": "./dist/review/hosted.js"
    },
    "./review/manifest": {
      "types": "./dist/review/manifest.d.ts",
      "default": "./dist/review/manifest.js"
    },
    "./ship": {
      "types": "./dist/ship/index.d.ts",
      "default": "./dist/ship/index.js"
    },
    "./ship/react": {
      "types": "./dist/ship/react.d.ts",
      "default": "./dist/ship/react.js"
    },
    "./storybook": {
      "types": "./dist/storybook/index.d.ts",
      "default": "./dist/storybook/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "fmt": "vp fmt --write src/ tests/",
    "fmt:check": "vp fmt --check src/ tests/",
    "check": "vp run typecheck && vp run lint && vp run fmt:check && vp run test"
  },
  "dependencies": {
    "@neokapi/kapi-format": "^1.0.0",
    "@swc/core": "^1.16.1",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@storybook/react-vite": "^10.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@storybook/react-vite": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
