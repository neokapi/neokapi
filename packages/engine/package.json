{
  "name": "@neokapi/engine",
  "version": "0.2.0",
  "private": false,
  "description": "The kapi content engine (WebAssembly) as a typed npm package: a dedicated Worker that runs the engine and keeps its workspace in the browser, the KapiRuntime facade, a versioned ABI with feature detection, and typed host-capability bridges. The wasm asset is served separately (CDN or self-hosted).",
  "keywords": [
    "wasm",
    "webassembly",
    "localization",
    "l10n",
    "content-model",
    "kapi",
    "neokapi"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neokapi/neokapi.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/neokapi/neokapi/tree/main/packages/engine#readme",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./memfs": "./src/memfs.ts",
    "./abi": "./src/abi.ts",
    "./capabilities": "./src/capabilities.ts",
    "./sqlite": "./src/sqlite.ts",
    "./worker": "./src/worker.ts",
    "./storage": "./src/storage.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./memfs": {
        "types": "./dist/memfs.d.ts",
        "default": "./dist/memfs.js"
      },
      "./abi": {
        "types": "./dist/abi.d.ts",
        "default": "./dist/abi.js"
      },
      "./capabilities": {
        "types": "./dist/capabilities.d.ts",
        "default": "./dist/capabilities.js"
      },
      "./sqlite": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "./storage": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "dependencies": {
    "@neokapi/contract-types": "^0.1.0",
    "@sqlite.org/sqlite-wasm": "catalog:"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
