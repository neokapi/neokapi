{
  "name": "@neokapi/contract-types",
  "version": "0.1.0",
  "private": false,
  "description": "Shared TypeScript contract types for the neokapi engine: flow/tool IO-contract atoms, schema-language types, content-model types and the review model, generated from the Go sources of truth (core/schema, core/format/schema, core/model, core/review, neokapi.content.v1). Drift-gated against the Go definitions in CI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neokapi/neokapi.git",
    "directory": "packages/contract-types"
  },
  "homepage": "https://github.com/neokapi/neokapi/tree/main/packages/contract-types#readme",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract.gen": "./src/contract.gen.ts",
    "./content.gen": "./src/content.gen.ts",
    "./review.gen": "./src/review.gen.ts",
    "./manual": "./src/manual.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contract.gen": {
        "types": "./dist/contract.gen.d.ts",
        "default": "./dist/contract.gen.js"
      },
      "./content.gen": {
        "types": "./dist/content.gen.d.ts",
        "default": "./dist/content.gen.js"
      },
      "./review.gen": {
        "types": "./dist/review.gen.d.ts",
        "default": "./dist/review.gen.js"
      },
      "./manual": {
        "types": "./dist/manual.d.ts",
        "default": "./dist/manual.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
