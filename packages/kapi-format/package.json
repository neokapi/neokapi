{
  "name": "@neokapi/kapi-format",
  "version": "1.0.1",
  "private": false,
  "description": "Canonical TypeScript schema for the Kapi Bundle Format (KBF). Block/Run content model, reference Level-1 preview renderer, target validator, annotation overlay resolver. Mirrors core/kbf in Go byte-for-byte against shared golden fixtures.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neokapi/neokapi.git",
    "directory": "packages/kapi-format"
  },
  "homepage": "https://github.com/neokapi/neokapi/tree/main/packages/kapi-format#readme",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./block": "./src/block.ts",
    "./vocabulary": "./src/vocabulary.ts",
    "./preview": "./src/preview.ts",
    "./annotation": "./src/annotation.ts",
    "./kbf": "./src/kbf.ts",
    "./target-plural": "./src/target-plural.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./block": {
        "types": "./dist/block.d.ts",
        "default": "./dist/block.js"
      },
      "./vocabulary": {
        "types": "./dist/vocabulary.d.ts",
        "default": "./dist/vocabulary.js"
      },
      "./preview": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "./annotation": {
        "types": "./dist/annotation.d.ts",
        "default": "./dist/annotation.js"
      },
      "./kbf": {
        "types": "./dist/kbf.d.ts",
        "default": "./dist/kbf.js"
      },
      "./target-plural": {
        "types": "./dist/target-plural.d.ts",
        "default": "./dist/target-plural.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "vp check --no-fmt --no-lint",
    "validate": "node --experimental-strip-types examples/validate.ts",
    "test": "vp test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
