  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "path": {
      "type": "array",
      "items": {
        "description": "a run index, {\"plural\": form} or {\"select\": case}",
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "object",
            "properties": {
              "plural": {
                "type": "string",
                "description": "a plural form: zero, one, two, few, many, other, or =N",
                "anyOf": [
                  {
                    "enum": [
                      "zero",
                      "one",
                      "two",
                      "few",
                      "many",
                      "other"
                    ]
                  },
                  {
                    "pattern": "^=[0-9]+(\\.[0-9]+)?$"
                  }
                ]
              }
            },
            "required": [
              "plural"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "select": {
                "type": "string",
                "description": "a select case"
              }
            },
            "required": [
              "select"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "a walk into a plural or select: a run index, then the form or case, repeated"
    }
  },
  "title": "kapi.change-result/v1",
  "description": "The outcome of a change set: its status, each document written or read, and each operation's outcome.",
  "required": [
