# Generated kapi/bowrain skill copies. The canonical source is cli/skills/data/
# (embedded in the binary). Regenerate the dogfood copies with `make dev-skills`
# and the Claude Code plugin bundle with `make plugin-bundle`. Hand-authored
# skills (e.g. .claude/skills/walkthrough-*) stay committed and are not ignored.
/.claude/skills/kapi/
/.claude/skills/kapi-*/
/.claude/skills/bowrain-*/
/packages/kapi-claude-plugin/plugins/kapi/skills/

# Throwaway kapi config/data/cache home for in-repo (non-dogfood) invocations — see Makefile KAPI_ISO_ENV
.kapi-iso/

# Synthetic project stores written by scripts/contention-harness (removed on
# exit unless it is run with -keep)
.contention-harness/

# Compiled Go tool binaries (built into their module dirs by `go build ./...`)
/scripts/gen-refs/gen-refs
/scripts/contract-audit/contract-audit
/scripts/checkeval/checkeval
/scripts/contexteval/contexteval
/scripts/contention-harness/contention-harness
# Stray build outputs (use `make` targets, which place binaries under bin/ or
# the wasm demo dir — these default `go build` outputs must never be committed).
# `go build ./scripts/<tool>` from the REPO ROOT writes ./<tool>, not
# ./scripts/<tool>/<tool>, so the root-level names need their own rules;
# scripts/check-tracked-binaries.sh is the backstop for the ones not listed.
/bowrain/bowrain
/checkeval
/contexteval
/kapi-wasm
/kapi/kapi-wasm-cli

# Transient libpdfium build/work dir (release-pdfium.yml + local plugin tests)
pdfium-work/

# nfpm binary-staging dir (release.yml deb/rpm build); the staged kapi binary
# must never be committed.
packaging/.stage/

# Operator tool built ad hoc via `go run`/`go build` (bowrain/cmd/stripe-provision)
/stripe-provision
