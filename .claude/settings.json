{
  "env": {
    "GOFLAGS": "-trimpath"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/setup-remote.sh",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "vpx @jonchurch/claude-code-gh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.sh; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 30,
            "statusMessage": "Formatting the edited file..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
