# Dogfood recipe: neokapi localizes its own surfaces with kapi.
#
# This is the repo-root project that the upward recipe walk discovers
# (core/project.ResolveLayout). Every other in-repo kapi invocation must
# isolate itself per the contract in CLAUDE.md ("Dogfooding kapi") —
# KAPI_NO_PROJECT=1 et al. — so only the dogfood workflow binds here.
#
# Surfaces:
#   framework-data   — generated tool/format metadata → gettext MO catalogs
#                      embedded in the kapi binary (core/i18n)
#   kapi-desktop-ui  — KLF catalogs extracted from the React frontend by
#                      @neokapi/kapi-react → public/translations/<locale>.json
#   bowrain-app-ui   — the shared bowrain SPA (bowrain/packages/{app,ui} + the
#                      web and desktop shells), same kapi-react pipeline →
#                      each shell's public/translations/<locale>.json
#   bowrain-ctrl-ui  — the ctrl admin app (bowrain/apps/ctrl)
#   bowrain-pulse-ui — the pulse dashboard (bowrain/apps/pulse)
#   docs             — the kapi Docusaurus site → web/i18n/<locale>/ tree
#   docs-bowrain     — the bowrain Docusaurus site (bowrain/web/docs) →
#                      bowrain/web/docs/i18n/<locale>/ tree
#   demo-narration   — harness demo scripts → generated demo.<lang>.yaml
#                      sidecars (harness/demos/<id>/, overlaid at load time)
#   emails           — KLF catalogs extracted from the React Email templates
#                      (bowrain/emails/src) by @neokapi/kapi-react → per-locale
#                      template renders under bowrain/mailer/templates/<lang>/
#                      (make l10n-emails)
#   email-subjects   — transactional-email subject lines
#                      (bowrain/mailer/subjects/en.json) → subjects/<lang>.json
#   landing          — KLF catalogs extracted from the bowrain landing SPA
#                      (bowrain/web/landing/src) → committed runtime catalogs
#                      bowrain/web/landing/translations/<lang>.json
#                      (make l10n-landing)
#
# Drive it with the l10n-* Makefile targets. Seeds (brand voice, termbase,
# reviewed TM) live under l10n/.
version: v1
name: neokapi
defaults:
  source_language: en
  target_languages: [nb]
  brand_voice:
    profile_file: l10n/brand-voice.yaml
  # termbase_source is the committed, git-tracked glossary (the review surface
  # `kapi apply` term-edits write to); termbase is the gitignored cache the
  # source compiles into. Source of truth lives in git, never in the cache.
  termbase_source: l10n/termbase.klftb
  termbase: .kapi/termbase.db
  tm:
    fuzzy_threshold: 75
  # YAML surface = the harness demo scripts (the only yaml content items).
  # Only the spoken/displayed keys are translatable — never ids, beats,
  # commands, paths, or timings. Declared here (not per-item) because the
  # flow-run path that l10n-demos drives binds reader config from
  # defaults.formats; extract/up/merge merge these same defaults per item.
  formats:
    yaml:
      config:
        keyPathPatterns:
          - title
          - subtitle
          - narration.*.text
          - narration.*.caption
    # Docs frontmatter: same reason as yaml above — the flow-run path behind
    # l10n-docs / l10n-bowrain-docs binds reader config from defaults.formats
    # only, so the frontmatter keys must live here too (the per-item config
    # below covers extract/up/merge, which overlay these defaults per item).
    markdown:
      config:
        translateFrontMatter: true
        frontMatterKeys: [title, description, sidebar_label]
    mdx:
      config:
        translateFrontMatter: true
        frontMatterKeys: [title, description, sidebar_label]
  exclude:
    - "**/node_modules/**"
    - "**/.git/**"
    - "web/build/**"
    - "web/i18n/**"
    - "bowrain/web/docs/build/**"
    - "bowrain/web/docs/i18n/**"
    - "harness/public/**"
    - "**/testdata/**"
content:
  - name: framework-data
    items:
      - path: core/i18n/builtins/metadata.json
        format:
          name: json
          config:
            extractAllPairs: false
            useKeyAsName: true
            useFullKeyPath: true
            useLeadingSlashOnKeyPath: true
            extractionRules: "(display_name|description|title|label)$"
        target: core/i18n/catalogs/{lang}.mo
  - name: kapi-desktop-ui
    items:
      - path: apps/kapi-desktop/frontend/i18n/**/*.klf
        target: apps/kapi-desktop/frontend/i18n-{lang}/{filename}
  - name: bowrain-app-ui
    items:
      - path: bowrain/packages/app/i18n/**/*.klf
        target: bowrain/packages/app/i18n-{lang}/{filename}
  - name: bowrain-ctrl-ui
    items:
      - path: bowrain/apps/ctrl/i18n/**/*.klf
        target: bowrain/apps/ctrl/i18n-{lang}/{filename}
  - name: bowrain-pulse-ui
    items:
      - path: bowrain/apps/pulse/i18n/**/*.klf
        target: bowrain/apps/pulse/i18n-{lang}/{filename}
  - name: docs
    items:
      - path: web/docs/**/*.md
        format:
          name: markdown
          config:
            translateFrontMatter: true
            frontMatterKeys: [title, description, sidebar_label]
        target: web/i18n/{lang}/docusaurus-plugin-content-docs/current/{path}.md
      - path: web/docs/**/*.mdx
        format:
          name: mdx
          config:
            translateFrontMatter: true
            frontMatterKeys: [title, description, sidebar_label]
        target: web/i18n/{lang}/docusaurus-plugin-content-docs/current/{path}.mdx
  - name: docs-bowrain
    items:
      - path: bowrain/web/docs/docs/**/*.md
        format:
          name: markdown
          config:
            translateFrontMatter: true
            frontMatterKeys: [title, description, sidebar_label]
        target: bowrain/web/docs/i18n/{lang}/docusaurus-plugin-content-docs/current/{path}.md
      - path: bowrain/web/docs/docs/**/*.mdx
        format:
          name: mdx
          config:
            translateFrontMatter: true
            frontMatterKeys: [title, description, sidebar_label]
        target: bowrain/web/docs/i18n/{lang}/docusaurus-plugin-content-docs/current/{path}.mdx
  - name: emails
    items:
      - path: bowrain/emails/i18n/**/*.klf
        target: bowrain/emails/i18n-{lang}/{filename}
  - name: email-subjects
    items:
      - path: bowrain/mailer/subjects/en.json
        format:
          name: json
        target: bowrain/mailer/subjects/{lang}.json
  - name: landing
    items:
      - path: bowrain/web/landing/i18n/**/*.klf
        target: bowrain/web/landing/i18n-{lang}/{filename}
  - name: demo-narration
    items:
      # Narrated demo-video scripts. The English demo.yaml is the master;
      # localized narration is GENERATED into committed demo.<lang>.yaml
      # sidecars (make l10n-demos, TM-driven) that the harness overlays at
      # load time. Never hand-edit a sidecar — fix the TM seed instead
      # (l10n/tm/demo-narration-<lang>.klftm). Translatable keys are
      # selected by defaults.formats.yaml.config.keyPathPatterns above.
      - path: harness/demos/*/demo.yaml
        format:
          name: yaml
        target: harness/demos/{dir}/demo.{lang}.yaml
flows:
  # Exact-match TM leverage only (no AI, no checks): the deterministic pass
  # behind `make l10n-demos`. Named tm-recycle so it does not shadow the
  # built-in `recycle`/`translate` flows (built-ins win in `kapi run`).
  tm-recycle:
    steps:
      - tool: recycle
        config:
          fillTarget: true
          fillTargetThreshold: 100
  # TM-driven translation: reviewed translations live in the project TM
  # (seeded from l10n/tm/*.tmx); exact matches fill the target, terminology
  # compliance is checked against the project termbase.
  translate:
    steps:
      - tool: recycle
        config:
          fillTarget: true
          fillTargetThreshold: 100
      - tool: term-check
  # AI translation for new/changed strings: TM first, then translate for
  # the misses (brand voice + glossary are bound project-wide), then checks.
  # Requires provider credentials (keychain or ANTHROPIC_API_KEY).
  translate-ai:
    steps:
      - tool: recycle
        config:
          fillTarget: true
          fillTargetThreshold: 100
      - tool: translate
        config:
          provider: anthropic
      - tool: term-check
      - tool: qa
  pseudo:
    steps:
      - tool: pseudo-translate

# ─────────────────────────────────────────────────────────────────────────────
# Customer #1: bowrain.cloud dogfood — ACTIVATED 2026-07-17 (epic 017-F, D2)
#
# neokapi is the first real workspace on Bowrain. `kapi push` sends every surface
# above to the project below; nb drafts land in the governed review queue and
# approved segments round-trip back into l10n/tm/*.klftm.
#
# converge: manual — a push moves content but does NOT auto-start a server AI
# convergence run. The first on-push run (2026-07-17) tried to AI-draft the whole
# ~18.8k-block untranslated corpus with an empty server TM (TM 0 · AI everything)
# and stalled on the workspace credit allowance. Convergence is now started
# deliberately — scoped, and only once the server TM is seeded and/or a BYO AI
# key is set (BYO burns no credits, DECISIONS L3) — via `kapi up` or the REST
# convergence endpoint. Transport (kapi push) stays pure either way.
#
# This `server:` block makes the recipe bowrain-connected. It is the ONLY in-repo
# kapi invocation that binds here — every other one isolates via KAPI_NO_PROJECT
# (CLAUDE.md "Dogfooding kapi"), so tests / make targets / recorders are
# unaffected. The nightly + manual sync runs in .github/workflows/dogfood-sync.yml
# (gated on the DOGFOOD_SYNC_ENABLED repo variable, token in BOWRAIN_AUTH_TOKEN).
#
# To disconnect: re-comment this block and unset DOGFOOD_SYNC_ENABLED. Runbook:
# web/docs/contribute/notes-internal/dogfood-sync.md
server:
  url: "https://app.bowrain.cloud/bowrain-hq/uek630Q5"   # <server>/<workspace>/<project-id>
  stream: "$auto"      # auto-detect from git branch / CI (default)
  converge: manual     # push never auto-converges; start the loop deliberately
