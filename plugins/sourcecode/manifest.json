{
  "manifest_version": "1",
  "plugin": "sourcecode",
  "version": "0.3.0",
  "description": "Reads product copy and code comments out of source files, such as package descriptions, installer strings, cask notes and doc comments. The plugin never writes a file: kapi writes a comment back, in a language declared writable, only when the project's formatter agrees.",
  "homepage": "https://github.com/neokapi/neokapi/tree/main/plugins/sourcecode",
  "author": "Neokapi <hello@neokapi.dev>",
  "license": "Apache-2.0",
  "binary": "kapi-sourcecode",
  "min_kapi_version": "1.2.0",
  "group": "neokapi",
  "capabilities": {
    "selfcheck": true,
    "formats": [
      {
        "name": "sourcecode",
        "display_name": "Source code",
        "description": "Product copy held in source files, such as package descriptions and installer notes.",
        "extensions": [
          ".rb"
        ],
        "mime_types": [
          "text/x-ruby"
        ],
        "capabilities": [
          "read"
        ],
        "schema": "formats/sourcecode/schema.json"
      }
    ],
    "comments": [
      {
        "language": "bash",
        "display_name": "Bash",
        "extensions": [
          ".sh",
          ".bash"
        ],
        "markers": {
          "line": [
            "#"
          ]
        },
        "canary": {
          "name": "a shell comment with a doubled word, below a ShellCheck directive and above a string holding a comment marker",
          "source": "#!/usr/bin/env bash\n# shellcheck disable=SC2086\n# Builds the the site.\nbuild() {\n  echo \"# not a comment\"\n}\n",
          "block": "func/build"
        }
      },
      {
        "language": "c",
        "display_name": "C",
        "extensions": [
          ".c",
          ".h"
        ],
        "markers": {
          "line": [
            "///",
            "//!",
            "//"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ],
          "splice": "\\"
        },
        "canary": {
          "name": "a Doxygen comment with a doubled word, below a licence tag and above a string holding a comment marker",
          "source": "// SPDX-License-Identifier: Apache-2.0\n/** Parses the the input. */\nint parse(const char *text);\nstatic const char *marker = \"// not a comment\";\n",
          "block": "func/parse"
        }
      },
      {
        "language": "cpp",
        "display_name": "C++",
        "extensions": [
          ".cpp",
          ".cc",
          ".cxx",
          ".c++",
          ".hpp",
          ".hh",
          ".hxx",
          ".h++",
          ".ipp",
          ".tpp"
        ],
        "markers": {
          "line": [
            "///",
            "//!",
            "//"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ],
          "splice": "\\"
        },
        "canary": {
          "name": "a Doxygen comment with a doubled word, below a clang-format directive and above a raw string holding a comment marker",
          "source": "// clang-format off\n/// Parses the the input.\nclass Parser {};\nauto marker = R\"(// not a comment)\";\n",
          "block": "class/Parser"
        }
      },
      {
        "language": "csharp",
        "display_name": "C#",
        "extensions": [
          ".cs"
        ],
        "markers": {
          "line": [
            "///",
            "//"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a C# documentation comment with a doubled word, below a ReSharper directive and above a string holding a comment marker",
          "source": "// ReSharper disable once UnusedMember.Global\n/// <summary>Parses the the input.</summary>\npublic class Parser\n{\n    private string marker = \"// not a comment\";\n}\n",
          "block": "class/Parser"
        }
      },
      {
        "language": "css",
        "display_name": "CSS",
        "extensions": [
          ".css"
        ],
        "markers": {
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a CSS comment with a doubled word, below a stylelint directive and above a string holding a comment marker",
          "source": "/* stylelint-disable no-empty-source */\n/* Styles the the header. */\n.header { content: \"/* not a comment */\"; }\n",
          "block": "rule/.header"
        }
      },
      {
        "language": "java",
        "display_name": "Java",
        "extensions": [
          ".java"
        ],
        "markers": {
          "line": [
            "//"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a Javadoc comment with a doubled word, below an inspection suppression and above a string holding a comment marker",
          "source": "//noinspection unused\n/** Parses the the input. */\npublic class Parser {\n    String marker = \"// not a comment\";\n}\n",
          "block": "class/Parser"
        }
      },
      {
        "language": "javascript",
        "display_name": "JavaScript",
        "extensions": [
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "markers": {
          "line": [
            "//",
            "#!"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a JavaScript doc comment with a doubled word, below a shebang and above a template literal holding a comment marker",
          "source": "#!/usr/bin/env node\n/** Reads the the config. */\nexport function read() {\n  return `// not a comment`;\n}\n",
          "block": "func/read"
        },
        "rewrite": {
          "canary": {
            "name": "canary.js",
            "source": "// eslint-disable-next-line no-console\n// Reads the config.\nexport function read() {\n  return 1;\n}\n\n/**\n * Writes the config.\n */\nexport function write() {}\n",
            "block": "func/read",
            "refused": "eslint-disable-next-line no-console",
            "delimited": "func/write",
            "terminator": "Writes the config */ and returns."
          },
          "formatters": [
            {
              "name": "oxfmt",
              "detect": [
                {
                  "file": ".oxfmtrc.json"
                },
                {
                  "file": ".oxfmtrc.jsonc"
                },
                {
                  "file": "vite.config.ts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.mts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.js",
                  "contains": "vite-plus"
                }
              ],
              "command": [
                "oxfmt",
                "--stdin-filepath={file}"
              ]
            },
            {
              "name": "prettier",
              "detect": [
                {
                  "file": ".prettierrc"
                },
                {
                  "file": ".prettierrc.json"
                },
                {
                  "file": ".prettierrc.json5"
                },
                {
                  "file": ".prettierrc.yaml"
                },
                {
                  "file": ".prettierrc.yml"
                },
                {
                  "file": ".prettierrc.toml"
                },
                {
                  "file": ".prettierrc.js"
                },
                {
                  "file": ".prettierrc.cjs"
                },
                {
                  "file": ".prettierrc.mjs"
                },
                {
                  "file": "prettier.config.js"
                },
                {
                  "file": "prettier.config.cjs"
                },
                {
                  "file": "prettier.config.mjs"
                },
                {
                  "file": "package.json",
                  "contains": "\"prettier\":"
                }
              ],
              "command": [
                "prettier",
                "--stdin-filepath",
                "{file}"
              ]
            }
          ],
          "formatter_canary": "export function read() {\n        // Indented too far.\n  return 1;\n}\n"
        }
      },
      {
        "language": "python",
        "display_name": "Python",
        "extensions": [
          ".py"
        ],
        "markers": {
          "line": [
            "#"
          ]
        },
        "canary": {
          "name": "a Python comment with a doubled word, below a directive and above a string holding a comment marker",
          "source": "#!/usr/bin/env python3\n# noqa: E501\n# Parses the the input.\ndef parse(text):\n    return \"# not a comment\" + text\n",
          "block": "func/parse"
        }
      },
      {
        "language": "ruby",
        "display_name": "Ruby",
        "extensions": [
          ".rb",
          ".rake",
          ".gemspec",
          ".ru"
        ],
        "markers": {
          "line": [
            "#"
          ],
          "block": [
            {
              "open": "=begin",
              "close": "=end"
            }
          ]
        },
        "canary": {
          "name": "a Ruby comment with a doubled word, below a magic comment and above a string holding a comment marker",
          "source": "# frozen_string_literal: true\n\n# Parses the the input.\ndef parse(text)\n  \"# not a comment #{text}\"\nend\n",
          "block": "func/parse"
        }
      },
      {
        "language": "rust",
        "display_name": "Rust",
        "extensions": [
          ".rs"
        ],
        "markers": {
          "line": [
            "///",
            "//!",
            "//"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/",
              "nested": true
            }
          ]
        },
        "canary": {
          "name": "a Rust doc comment with a doubled word, below a licence tag and above a string holding a comment marker",
          "source": "// SPDX-License-Identifier: Apache-2.0\n/// Parses the the input.\npub fn parse(text: &str) -> &str {\n    let _ = \"// not a comment\";\n    text\n}\n",
          "block": "func/parse"
        }
      },
      {
        "language": "tsx",
        "display_name": "TSX",
        "extensions": [
          ".tsx"
        ],
        "markers": {
          "line": [
            "//",
            "#!"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a TSX doc comment with a doubled word, above JSX text holding a comment marker",
          "source": "/** Renders the the greeting. */\nexport function Greeting() {\n  return <p>// not a comment {/* inline */}</p>;\n}\n",
          "block": "func/Greeting"
        },
        "rewrite": {
          "canary": {
            "name": "canary.tsx",
            "source": "// eslint-disable-next-line no-console\n// Renders the greeting.\nexport function Greeting() {\n  return <p>Hello</p>;\n}\n\n/**\n * Renders the farewell.\n */\nexport function Farewell() {\n  return <p>Bye</p>;\n}\n",
            "block": "func/Greeting",
            "refused": "eslint-disable-next-line no-console",
            "delimited": "func/Farewell",
            "terminator": "Renders the farewell */ and returns."
          },
          "formatters": [
            {
              "name": "oxfmt",
              "detect": [
                {
                  "file": ".oxfmtrc.json"
                },
                {
                  "file": ".oxfmtrc.jsonc"
                },
                {
                  "file": "vite.config.ts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.mts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.js",
                  "contains": "vite-plus"
                }
              ],
              "command": [
                "oxfmt",
                "--stdin-filepath={file}"
              ]
            },
            {
              "name": "prettier",
              "detect": [
                {
                  "file": ".prettierrc"
                },
                {
                  "file": ".prettierrc.json"
                },
                {
                  "file": ".prettierrc.json5"
                },
                {
                  "file": ".prettierrc.yaml"
                },
                {
                  "file": ".prettierrc.yml"
                },
                {
                  "file": ".prettierrc.toml"
                },
                {
                  "file": ".prettierrc.js"
                },
                {
                  "file": ".prettierrc.cjs"
                },
                {
                  "file": ".prettierrc.mjs"
                },
                {
                  "file": "prettier.config.js"
                },
                {
                  "file": "prettier.config.cjs"
                },
                {
                  "file": "prettier.config.mjs"
                },
                {
                  "file": "package.json",
                  "contains": "\"prettier\":"
                }
              ],
              "command": [
                "prettier",
                "--stdin-filepath",
                "{file}"
              ]
            }
          ],
          "formatter_canary": "export function Greeting() {\n        // Indented too far.\n  return <p>Hello</p>;\n}\n"
        }
      },
      {
        "language": "typescript",
        "display_name": "TypeScript",
        "extensions": [
          ".ts",
          ".mts",
          ".cts"
        ],
        "markers": {
          "line": [
            "//",
            "#!"
          ],
          "block": [
            {
              "open": "/*",
              "close": "*/"
            }
          ]
        },
        "canary": {
          "name": "a TypeScript doc comment with a doubled word, below a directive and above a string holding a comment marker",
          "source": "// eslint-disable-next-line no-console\n/** Parses the the input. */\nexport function parse(src: string): string {\n  return \"// not a comment\" + src;\n}\n",
          "block": "func/parse"
        },
        "rewrite": {
          "canary": {
            "name": "canary.ts",
            "source": "// eslint-disable-next-line no-console\n// Parses the input.\nexport function parse(src: string): string {\n  return src;\n}\n\n/**\n * Reads the config.\n */\nexport function read(): void {}\n",
            "block": "func/parse",
            "refused": "eslint-disable-next-line no-console",
            "delimited": "func/read",
            "terminator": "Reads the config */ and returns."
          },
          "formatters": [
            {
              "name": "oxfmt",
              "detect": [
                {
                  "file": ".oxfmtrc.json"
                },
                {
                  "file": ".oxfmtrc.jsonc"
                },
                {
                  "file": "vite.config.ts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.mts",
                  "contains": "vite-plus"
                },
                {
                  "file": "vite.config.js",
                  "contains": "vite-plus"
                }
              ],
              "command": [
                "oxfmt",
                "--stdin-filepath={file}"
              ]
            },
            {
              "name": "prettier",
              "detect": [
                {
                  "file": ".prettierrc"
                },
                {
                  "file": ".prettierrc.json"
                },
                {
                  "file": ".prettierrc.json5"
                },
                {
                  "file": ".prettierrc.yaml"
                },
                {
                  "file": ".prettierrc.yml"
                },
                {
                  "file": ".prettierrc.toml"
                },
                {
                  "file": ".prettierrc.js"
                },
                {
                  "file": ".prettierrc.cjs"
                },
                {
                  "file": ".prettierrc.mjs"
                },
                {
                  "file": "prettier.config.js"
                },
                {
                  "file": "prettier.config.cjs"
                },
                {
                  "file": "prettier.config.mjs"
                },
                {
                  "file": "package.json",
                  "contains": "\"prettier\":"
                }
              ],
              "command": [
                "prettier",
                "--stdin-filepath",
                "{file}"
              ]
            }
          ],
          "formatter_canary": "export function f(): number {\n        // Indented too far.\n  return 1;\n}\n"
        }
      }
    ]
  },
  "daemon": {
    "handshake": {
      "type": "stdio-handshake",
      "fields": [
        "socket",
        "version"
      ]
    }
  }
}
