{
  "name": "kapi-claude-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Test harness that demonstrates and records kapi driven by Claude Code as narrated videos.",
  "scripts": {
    "setup": "tsx src/cli/setup.ts",
    "demo": "tsx src/cli/run.ts",
    "capture": "tsx src/cli/run.ts --only=capture",
    "artifacts": "tsx src/cli/run.ts --only=artifacts",
    "narrate": "tsx src/cli/run.ts --only=narrate",
    "render": "tsx src/cli/run.ts --only=render",
    "studio": "tsx src/cli/run.ts --registry && remotion studio src/remotion/index.ts",
    "list": "tsx src/cli/run.ts --list",
    "audit": "tsx src/cli/audit.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.522",
    "@remotion/captions": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/google-fonts": "4.0.522",
    "@remotion/install-whisper-cpp": "4.0.522",
    "@remotion/media": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "@remotion/rough-notation": "4.0.522",
    "@remotion/sfx": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.522",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
