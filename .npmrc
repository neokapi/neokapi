# pnpm registry/auth config. Behavioral pnpm settings (workspace linking,
# pre/post scripts, dependency overrides) live in pnpm-workspace.yaml — pnpm
# reads those from there, not from .npmrc/package.json. See https://pnpm.io/settings.

# Every package resolves from this registry, whatever a developer's own
# configuration names, so the lockfile is written the same on every machine.
# scripts/dependabot-relock.py holds each lockfile to it.
registry=https://registry.npmjs.org/

# Suppress peer-dependency warnings from Storybook's transitive deps that have
# not declared Vite 8 support yet.
loglevel=error
