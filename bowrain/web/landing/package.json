{
  "name": "bowrain-web-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:nb": "LOCALE=nb vp build",
    "compile": "vpx neokapi-i18n compile i18n-qps/ --out translations",
    "compile:nb": "vpx neokapi-i18n compile i18n-nb/ --out translations --locale nb",
    "extract": "vpx neokapi-i18n extract --out i18n/ --target-locale qps --src \"src/**/*.{tsx,jsx}\"",
    "preview": "vp preview",
    "lint": "vp lint",
    "check": "vp check",
    "fmt": "vp fmt"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@neokapi/i18n-react": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.25.0",
    "posthog-js": "^1.404.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.5"
  }
}
