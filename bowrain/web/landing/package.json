{
  "name": "bowrain-web-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:nb": "LOCALE=nb vp build",
    "build:qps": "LOCALE=qps vp build",
    "compile": "vpx neokapi-i18n compile i18n-qps/ --out translations",
    "compile:nb": "vpx neokapi-i18n compile i18n-nb/ --out translations --locale nb",
    "extract": "vpx neokapi-i18n extract --out i18n/ --target-locale qps --src \"src/**/*.{tsx,jsx}\"",
    "preview": "vp preview",
    "lint": "vp lint",
    "check": "vp check",
    "fmt": "vp fmt",
    "test:e2e": "playwright test",
    "test": "vp test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@neokapi/docs-shared": "*",
    "@neokapi/i18n-react": "*",
    "@neokapi/ui-primitives": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11"
  }
}
